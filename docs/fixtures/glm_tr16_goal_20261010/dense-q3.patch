+            for(int t=0;t<rows;++t) {
+                std::vector<int> ranking(ne);std::iota(ranking.begin(),ranking.end(),0);
+                auto prob=[&](int e){return 1.f/(1.f+std::exp(-x[t*ne+e]));};
+                auto score=[&](int e){return prob(e)+bias[e]+bonus[e];};
+                std::stable_sort(ranking.begin(),ranking.end(),[&](int a,int b){return score(a)>score(b);});
+                double denominator=0;for(int j=0;j<top;++j)denominator+=prob(ranking[j]);
+                std::vector<double> original(top),expected(top);double total=0,kept=0;
+                for(int j=0;j<top;++j){original[j]=prob(ranking[j])*scale/(denominator+1e-20);total+=original[j];}
+                for(int j=0;j<top;++j){expected[j]=original[j]<double(share)*scale ? 0 : original[j];kept+=expected[j];}
+                if(renorm && kept<total) {
+                    if(kept>0)for(double& w:expected)w*=total/kept;
