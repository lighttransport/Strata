+// Opt-in pruning keeps the selected experts' original total mass. If the
+// threshold removes every expert, retain the largest original weight (first tie).
+// With no removed weight, do not touch the normalized values.
+__device__ void renormalize_routes(float *weights, int k, float cutoff) {
+    float total = 0.f, retained = 0.f, largest = -1.f;
+    int best = 0;
+    bool removed = false;
+    for (int j = 0; j < k; ++j) {
+        const float w = weights[j];
+        total += w;
+        if (w > largest) { largest = w; best = j; }
+        if (w < cutoff) { weights[j] = 0.f; removed |= w != 0.f; }
+        else retained += w;
+    }
+    if (!removed) return;
+    if (retained > 0.f) {
+        const float factor = total / retained;
+        for (int j = 0; j < k; ++j) weights[j] *= factor;
+    } else {
+        weights[best] = total;
+    }
+}
