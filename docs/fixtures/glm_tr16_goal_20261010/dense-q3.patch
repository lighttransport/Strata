+                        throw std::runtime_error("route oracle mismatch ne="+std::to_string(ne)+" shape="+std::to_string(shape)+" row="+std::to_string(t)+" j="+std::to_string(j));
+                }
+                const double wanted=std::accumulate(expected.begin(),expected.end(),0.);
+                if(std::abs(actual_mass-wanted)>5e-6)throw std::runtime_error("route mass mismatch");
+                ++checks;
+            }
+        };
+        Buffer<int> ids(top);Buffer<float> weights(top);
+        k::glm_router(dx.p,db.p,ids.p,weights.p,ne,top,scale,nullptr,dbonus.p);
+        verify(ids.get(),weights.get(),1);
+        if(ne>512)continue;
+        Buffer<int> batched_ids(top*nt);Buffer<float> batched_weights(top*nt);
+        k::glm_router_tokens(dx.p,db.p,batched_ids.p,batched_weights.p,ne,top,scale,nt,nullptr,dbonus.p);
+        verify(batched_ids.get(),batched_weights.get(),nt);
+        const size_t bytes=k::glm_mailbox_bytes(1,1,top,hidden);
+        void *host=nullptr,*mapped=nullptr;ck(cudaHostAlloc(&host,bytes,cudaHostAllocMapped));std::memset(host,0,bytes);
+        ck(cudaHostGetDevicePointer(&mapped,host,0));
+        auto hv=k::glm_mailbox_view(host,1,1,top,hidden),dv=k::glm_mailbox_view(mapped,1,1,top,hidden);
+        Buffer<float> activation(hidden);activation.put(std::vector<float>(hidden,1.f));
+        Buffer<unsigned> generation(1);generation.put({17});
+        k::glm_router_publish(dx.p,db.p,ids.p,weights.p,ne,top,scale,dbonus.p,dv,0,activation.p,generation.p,nullptr);
+        ck(cudaDeviceSynchronize());
+        verify(std::vector<int>(hv.ids,hv.ids+top),std::vector<float>(hv.weights,hv.weights+top),1);
+        if(hv.flags[0]!=17)throw std::runtime_error("mailbox generation mismatch");
+        for(int j=0;j<hidden;++j)if(hv.act[j]!=1.f)throw std::runtime_error("mailbox activation mismatch");
+        ck(cudaFreeHost(host));
+    }
