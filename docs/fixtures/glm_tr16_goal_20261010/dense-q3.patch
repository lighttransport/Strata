+    const bool renorm=std::getenv("STRATA_GLM_ROUTE_RENORMALIZE") && std::string(std::getenv("STRATA_GLM_ROUTE_RENORMALIZE"))=="1";
+    constexpr int top=8, nt=3, hidden=64;
+    constexpr float scale=2.5f;
