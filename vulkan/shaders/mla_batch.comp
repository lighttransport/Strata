#version 450
layout(local_size_x=128) in;
layout(binding=0,std430) readonly buffer Cache { float cache[]; };
layout(binding=1,std430) readonly buffer Q { float q[]; };
layout(binding=2,std430) readonly buffer Ids { int ids[]; };
layout(binding=3,std430) readonly buffer Counts { uint counts[]; };
layout(binding=6,std430) writeonly buffer Y { float y[]; };
layout(push_constant) uniform Params { uint heads; uint latent; uint stride; float scale; } p;
shared float probability[2112];
void main(){
#ifdef STRATA_WIDE_DISPATCH
 uint group=gl_WorkGroupID.x+gl_WorkGroupID.y*gl_NumWorkGroups.x,stride=p.stride&65535u;
 if(group>=(p.stride>>16)*p.heads)return;
 uint query=group/p.heads,h=group%p.heads,t=gl_LocalInvocationID.x,count=counts[query];
 uint qbase=(query*p.heads+h)*p.latent,ibase=query*stride;
#else
 uint query=gl_WorkGroupID.x/p.heads,h=gl_WorkGroupID.x%p.heads,t=gl_LocalInvocationID.x,count=counts[query];
 uint qbase=(query*p.heads+h)*p.latent,ibase=query*p.stride;
#endif
 if(h>=p.heads) return;
 for(uint s=t;s<count;s+=128){precise float dot=0;for(uint i=0;i<p.latent;i++)dot+=q[qbase+i]*cache[uint(ids[ibase+s])*p.latent+i];probability[s]=dot*p.scale;}
 barrier();
 if(t==0){float mx=-3.402823e38,total=0;for(uint s=0;s<count;s++)mx=max(mx,probability[s]);for(uint s=0;s<count;s++){probability[s]=exp(probability[s]-mx);total+=probability[s];}for(uint s=0;s<count;s++)probability[s]/=total;}
 barrier();
 for(uint i=t;i<p.latent;i+=128){precise float sum=0;for(uint s=0;s<count;s++)sum+=probability[s]*cache[uint(ids[ibase+s])*p.latent+i];y[qbase+i]=sum;}
}
