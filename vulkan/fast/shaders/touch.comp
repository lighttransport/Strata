#version 450
// Tiny utility kernel for latency measurements: data[i] = value for i < count.
layout(local_size_x = 64) in;
layout(binding = 0, std430) buffer Data { uint data[]; };
layout(push_constant) uniform P { uint value, count; } p;
void main() {
  const uint i = gl_GlobalInvocationID.x;
  if (i < p.count) data[i] = p.value;
}
