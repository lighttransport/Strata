#version 450
#extension GL_ARB_gpu_shader_fp64 : require
#extension GL_GOOGLE_include_directive : require
#include "fp64_round.glsl"
layout(local_size_x = 256) in;
layout(binding = 0, std430) readonly buffer Input { uvec2 bits[]; };
layout(binding = 1, std430) writeonly buffer Output { uint result[]; };
layout(push_constant) uniform P { uint count; } p;
void main() {
  const uint i = gl_GlobalInvocationID.x;
  if (i < p.count) result[i] = floatBitsToUint(round_fp64_to_fp32(packDouble2x32(bits[i])));
}
