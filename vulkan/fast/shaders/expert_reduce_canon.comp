#version 450
layout(local_size_x = 256) in;
layout(binding = 0, std430) readonly buffer Partial {float v[];};
layout(binding = 1, std430) writeonly buffer Output {float y[];};
layout(push_constant) uniform P {uint size;} p;
void main() {
  const uint i = gl_GlobalInvocationID.x;
  if (i >= p.size) return;
  precise float a = v[i] + v[4u * p.size + i];
  precise float b = v[p.size + i] + v[5u * p.size + i];
  precise float c = v[2u * p.size + i] + v[6u * p.size + i];
  precise float d = v[3u * p.size + i] + v[7u * p.size + i];
  precise float ab = a + b, cd = c + d;
  y[i] = ab + cd;
}
