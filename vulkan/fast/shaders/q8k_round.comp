#version 450
// Canonical CPU expert activation grid: first largest-magnitude signed value,
// iscale=-127/max, nearest-even codes, float scale=1/iscale (no half conversion).
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"
#ifdef FP64_MATH
#extension GL_ARB_gpu_shader_fp64 : require
#include "fp64_round.glsl"
#endif
layout(local_size_x = 256) in;
layout(binding = 0, std430) readonly buffer In { float x[]; };
layout(binding = 1, std430) writeonly buffer Out { float y[]; };
layout(binding = 2, std430) readonly buffer Hits { uint hits[]; };
#ifdef CODES_AND_SUMS
layout(binding = 3, std430) writeonly buffer Metadata { float metadata[]; };
shared float codes[256];
#endif
layout(push_constant) uniform P { uint n, uofs, vector_size, tokens; } p;
#ifdef PORTABLE_REDUCTION
shared float maximum[256];
shared uint first_index[256];
shared uint invalid_input[256];
#else
shared float maximum[4];
shared uint first_index[4];
shared uint invalid_input[4];
#endif
void main() {
  const uint live = p.vector_size == 0 ? p.n : hits[p.uofs] * p.vector_size * p.tokens;
  if (gl_WorkGroupID.x * 256u >= live) return;
  const uint i = gl_GlobalInvocationID.x, t = gl_LocalInvocationID.x;
  const float value = i < live ? x[i] : 0;
  const bool invalid = isnan(value) || isinf(value);
  const uint bad_wave = subgroupMax(invalid ? 1u : 0u);
  const float m = subgroupMax(invalid ? 0.0 : abs(value));
  if (gl_SubgroupInvocationID == 0) {
    maximum[gl_SubgroupID] = m;
    invalid_input[gl_SubgroupID] = bad_wave;
  }
  barrier();
#ifdef PORTABLE_REDUCTION
  float largest = 0;
  for (uint wave = 0; wave < gl_NumSubgroups; ++wave) largest = max(largest, maximum[wave]);
#else
  const float largest = max(max(maximum[0], maximum[1]), max(maximum[2], maximum[3]));
#endif
  const uint index = subgroupMin(!invalid && abs(value) == largest ? t : 0xffffffffu);
  if (gl_SubgroupInvocationID == 0) first_index[gl_SubgroupID] = index;
  barrier();
#ifdef PORTABLE_REDUCTION
  uint first = 0xffffffffu;
  for (uint wave = 0; wave < gl_NumSubgroups; ++wave) first = min(first, first_index[wave]);
#else
  const uint first = min(min(first_index[0], first_index[1]), min(first_index[2], first_index[3]));
#endif
  uint bad = 0u;
  for (uint wave = 0; wave < gl_NumSubgroups; ++wave) bad |= invalid_input[wave];
  // With no finite maximum, first may be UINT_MAX. Never use that as an
  // input address. Propagate an invalid scale so callers reject this block.
  if (bad != 0u || first >= 256u) {
    const float nan_value = uintBitsToFloat(0x7fc00000u);
#ifdef CODES_AND_SUMS
    if (i < live) y[i] = 0.0;
    if (t == 0u) metadata[gl_WorkGroupID.x * 17u] = nan_value;
    if (t < 16u) metadata[gl_WorkGroupID.x * 17u + 1u + t] = 0.0;
#else
    if (i < live) y[i] = nan_value;
#endif
    return;
  }
  const float signed_max = x[gl_WorkGroupID.x * 256u + first];
#ifdef FP64_MATH
  precise float iscale = largest == 0 ? 0 : round_fp64_to_fp32(double(-127.0) / double(signed_max));
#else
  precise float iscale = largest == 0 ? 0 : -127.0 / signed_max;
#endif
  precise float scaled = iscale * value;
  precise float rounded = scaled + 12582912.0;
  const int code = min(127, int(floatBitsToUint(rounded) & 0x007fffffu) - 0x00400000);
#ifdef FP64_MATH
  const float d = largest == 0 ? 0 : round_fp64_to_fp32(double(1.0) / double(iscale));
#else
  const float d = largest == 0 ? 0 : 1.0 / iscale;
#endif
#ifdef CODES_AND_SUMS
  if (i < live) y[i] = float(code);
  codes[t] = float(code);
  barrier();
  if (t == 0) metadata[gl_WorkGroupID.x * 17u] = d;
  if (t < 16) {
    float sum = 0;
    for (uint j = 0; j < 16; ++j) sum += codes[t * 16u + j];
    metadata[gl_WorkGroupID.x * 17u + 1u + t] = sum;
  }
#else
  if (i < live) y[i] = float(code) * d;
#endif
}
