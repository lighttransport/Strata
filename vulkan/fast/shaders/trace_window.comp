#version 450
layout(local_size_x = 256) in;
layout(binding = 0, std430) readonly buffer Input { float x[]; };
layout(binding = 1, std430) writeonly buffer Trace { float trace[]; };
layout(binding = 2, std430) readonly buffer Step { uint pos; } step;
layout(push_constant) uniform P { uint width, position, tokens, destination; } p;
void main() {
  const uint i = gl_GlobalInvocationID.x;
  if (i < p.width && p.position >= step.pos && p.position - step.pos < p.tokens)
    trace[p.destination + i] = x[(p.position - step.pos) * p.width + i];
}
