#version 450
// First index of the maximum (std::max_element semantics).
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"
layout(local_size_x = 256) in;
layout(binding = 0, std430) readonly buffer L { float logits[]; };
layout(binding = 1, std430) writeonly buffer Out { int result[]; };
layout(push_constant) uniform P { uint n, rofs; } p;
shared float bv[256];
shared uint bi[256];
void main() {
  const uint t = gl_LocalInvocationID.x;
  float best = -3.402823e38;
  uint index = 0xffffffffu;
  for (uint i = t; i < p.n; i += 256) {
    const float v = logits[i];
    if (v > best) { best = v; index = i; }
  }
  bv[t] = best; bi[t] = index;
  barrier();
  for (uint off = 128; off > 0; off >>= 1) {
    if (t < off) {
      const float v = bv[t + off];
      const uint j = bi[t + off];
      if (v > bv[t] || (v == bv[t] && j < bi[t])) { bv[t] = v; bi[t] = j; }
    }
    barrier();
  }
  if (t == 0) result[p.rofs] = int(bi[0]);
}
