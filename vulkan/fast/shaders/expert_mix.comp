#version 450
// Resident-expert glue over a hit union (count at uofs, weights at uofs+33+4u+t).
// mode 0: h[(u*T+t)][i] = swiglu(gu[(u*T+t)][i], gu[(u*T+t)][n+i], limit).
// mode 1: out[t][d] = sum_u w[u][t] * y[(u*T+t)][d] (workgroup y = token).
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"
layout(local_size_x = 256) in;
layout(binding = 0, std430) readonly buffer In { float v[]; };
layout(binding = 1, std430) buffer Out { float o[]; };
layout(binding = 2, std430) readonly buffer Hits { uint hits[]; };
layout(push_constant) uniform P { uint mode, n, uofs, tokens; float limit; } p;
#ifdef CANON_SWIGLU
float canonical_exp(float x) {
  x = clamp(x, -87.0, 88.0);
  precise float mul = x * 1.44269504088896341;
  precise float rounded = mul + 12582912.0;
  precise float n = rounded - 12582912.0;
  float r = fma(n, -0.693359375, x);
  r = fma(n, 2.12194440e-4, r);
  float v = fma(1.9875691500e-4, r, 1.3981999507e-3);
  v = fma(v, r, 8.3334519073e-3);
  v = fma(v, r, 4.1665795894e-2);
  v = fma(v, r, 1.6666665459e-1);
  v = fma(v, r, 5.0000001201e-1);
  precise float rr = r * r;
  precise float y = fma(v, rr, r) + 1.0;
  return y * uintBitsToFloat(uint(int(n) + 127) << 23u);
}
#endif
void main() {
  const uint i = gl_GlobalInvocationID.x, count = hits[p.uofs];
  if (p.mode == 0) {
    const uint vec_index = i / p.n, e = i % p.n;
    if (vec_index >= count * p.tokens) return;
    float g = v[vec_index * 2 * p.n + e], u = v[vec_index * 2 * p.n + p.n + e];
    if (p.limit > 0) { g = min(g, p.limit); u = clamp(u, -p.limit, p.limit); }
#ifdef CANON_SWIGLU
    precise float denom = 1.0 + canonical_exp(-g);
    precise float silu = g / denom;
    o[vec_index * p.n + e] = silu * u;
#else
    o[vec_index * p.n + e] = g * sigmoid(g) * u;
#endif
  } else {
    const uint t = gl_WorkGroupID.y;
    if (i >= p.n) return;
    float s = 0;
    for (uint k = 0; k < count; k++) s += uintBitsToFloat(hits[p.uofs + 33 + 4 * k + t]) * v[(k * p.tokens + t) * p.n + i];
    o[t * p.n + i] = s;
  }
}
