#version 450
#ifdef FP64_SCALE
#extension GL_ARB_gpu_shader_fp64 : require
#extension GL_GOOGLE_include_directive : require
#include "fp64_round.glsl"
#endif
// One of the canonical CPU's eight dot lanes per z workgroup. Integer-valued
// codes/scales accumulate exactly in FP32; only the per-block scale FMAs round.
// A separate dispatch reduces the eight lane results in the CPU's fixed order.
layout(local_size_x = 256) in;
layout(binding = 0, std430) readonly buffer Weights { uint w[]; };
#ifdef VECTOR_WEIGHT_LOADS
layout(binding = 0, std430) readonly buffer WeightVectors { uvec4 w4[]; };
#endif
layout(binding = 1, std430) readonly buffer Codes { float x[]; };
layout(binding = 2, std430) readonly buffer Metadata { float meta[]; };
layout(binding = 3, std430) writeonly buffer Partial { float part[]; };
#ifdef TRACE_BLOCK_SCALE
layout(binding = 4, std430) writeonly buffer BlockTrace { float block_trace[]; };
#endif
layout(push_constant) uniform P {uint K, M, Mp, N, side;} p;
#ifndef NTILE
#define NTILE 64
#endif
#ifndef MTILE
#define MTILE 64
#endif
#if MTILE == 64
#define ROW_STEP 64u
#define ROW_GROUPS 4u
#elif MTILE == 32
#define ROW_STEP 32u
#define ROW_GROUPS 2u
#else
#error Unsupported expert row tile
#endif
#if NTILE == 16
#define Panel float
#define X_PANEL(K) xt[ci][K]
#define META_PANEL(A) A[ci]
#elif NTILE == 32
#define Panel vec2
#define X_PANEL(K) vec2(xt[ci][K], xt[ci + 16u][K])
#define META_PANEL(A) vec2(A[ci], A[ci + 16u])
#elif NTILE == 64
#define Panel vec4
#define X_PANEL(K) vec4(xt[ci][K], xt[ci + 16u][K], xt[ci + 32u][K], xt[ci + 48u][K])
#define META_PANEL(A) vec4(A[ci], A[ci + 16u], A[ci + 32u], A[ci + 48u])
#else
#error Unsupported expert column tile
#endif
#ifdef FP64_SCALE
Panel scale_fma(Panel a, Panel b, Panel c) {
  return Panel(fp32_fma_rne(a.x, b.x, c.x), fp32_fma_rne(a.y, b.y, c.y),
               fp32_fma_rne(a.z, b.z, c.z), fp32_fma_rne(a.w, b.w, c.w));
}
#define SCALE_FMA(A, B, C) scale_fma(A, B, C)
#else
#define SCALE_FMA(A, B, C) fma(A, B, C)
#endif
#ifdef TYPE_Q2K
#define CH 5u
#else
#define CH 6u
#endif
uint byte_at(uint b, uint i, uint row) {
  const uint word = w[((b * CH + i / 16u) * p.Mp + row) * 4u + (i % 16u) / 4u];
  return (word >> (8u * (i % 4u))) & 255u;
}
float integer_weight(uint b, uint row, uint i) {
#ifdef TYPE_Q2K
  const uint scale = byte_at(b, i / 16u, row) & 15u;
  const uint q = (byte_at(b, 16u + i / 128u * 32u + i % 32u, row) >> (2u * ((i % 128u) / 32u))) & 3u;
  return float(scale * q);
#else
  const uint side = p.side / 4u + b * 4u * p.Mp;
  const uint a0 = w[side + row], a1 = w[side + p.Mp + row], h = w[side + 2u * p.Mp + row];
  const uint s = i / 16u, sh = 8u * (s % 4u);
  const uint lo = ((s % 8u < 4u ? a0 : a1) >> (sh + (s >= 8u ? 4u : 0u))) & 15u;
  const uint hi = (h >> (sh + 2u * (s / 4u))) & 3u;
  const int scale = int(lo | (hi << 4u)) - 32;
  const uint qlo = (byte_at(b, 32u + i / 128u * 32u + i % 32u, row) >> (2u * ((i % 128u) / 32u))) & 3u;
  const uint qhi = (byte_at(b, i % 32u, row) >> (i / 32u)) & 1u;
  return float(scale * (int(qlo + 4u * qhi) - 4));
#endif
}
#ifdef VECTOR_WEIGHT_LOADS
float decoded_integer(uint s, uint dot_lane, uvec4 header, uint q0, uint q1, uint mask) {
  const uint si = 2u * s + dot_lane / 4u;
  const uint qlo = ((s < 4u ? q0 : q1) >> (2u * (s % 4u))) & 3u;
#ifdef TYPE_Q2K
  const uint scale = (header[si / 4u] >> (8u * (si % 4u))) & 15u;
  return float(scale * qlo);
#else
  const uint sh = 8u * (si % 4u);
  const uint a = si % 8u < 4u ? header.x : header.y;
  const uint lo = (a >> (sh + (si >= 8u ? 4u : 0u))) & 15u;
  const uint hi = (header.z >> (sh + 2u * (si / 4u))) & 3u;
  const int scale = int(lo | (hi << 4u)) - 32;
  return float(scale * (int(qlo + 4u * ((mask >> s) & 1u)) - 4));
#endif
}
#endif
shared float wt[32][MTILE], xt[NTILE][33];
shared float wd[MTILE], wm[MTILE], min0[MTILE], min1[MTILE];
shared float xd[64], sum0[64], sum1[64];
void main() {
  const uint t = gl_LocalInvocationID.x, lane = gl_WorkGroupID.z;
#if NTILE == 64
  const uint row0 = gl_WorkGroupID.x * ROW_STEP, col0 = gl_WorkGroupID.y * 64u;
#else
  const uint row0 = gl_WorkGroupID.x * ROW_STEP, col0 = gl_WorkGroupID.y * uint(NTILE);
#endif
  const uint ri = t % 16u, ci = t / 16u, blocks = p.K / 256u;
#if MTILE == 64
  precise Panel acc0 = Panel(0), acc1 = Panel(0), acc2 = Panel(0), acc3 = Panel(0);
#else
  precise Panel acc0 = Panel(0), acc1 = Panel(0);
#endif
  for (uint b = 0; b < blocks; ++b) {
#if MTILE == 32
    if (t < 128u) {
#endif
    const uint row = row0 + t % ROW_STEP;
#ifdef VECTOR_WEIGHT_LOADS
    if (row < p.M) {
      // All eight K subblocks reuse these metadata and payload words.
      // Each wave selects one byte of the same four-byte dot-lane group.
      const uint shift = 8u * (t / ROW_STEP), word = lane % 4u;
      const uint plane = lane / 4u;
#ifdef TYPE_Q2K
      const uvec4 header = w4[b * CH * p.Mp + row];
      const uint q0 = (w[((b * CH + 1u + plane) * p.Mp + row) * 4u + word] >> shift) & 255u;
      const uint q1 = (w[((b * CH + 3u + plane) * p.Mp + row) * 4u + word] >> shift) & 255u;
      const uint mask = 0u;
#else
      const uint side = p.side / 4u + b * 4u * p.Mp;
      const uvec4 header = uvec4(w[side + row], w[side + p.Mp + row], w[side + 2u * p.Mp + row], 0u);
      const uint q0 = (w[((b * CH + 2u + plane) * p.Mp + row) * 4u + word] >> shift) & 255u;
      const uint q1 = (w[((b * CH + 4u + plane) * p.Mp + row) * 4u + word] >> shift) & 255u;
      const uint mask = (w[((b * CH + plane) * p.Mp + row) * 4u + word] >> shift) & 255u;
#endif
#define PUT_WEIGHT(S) wt[4u * S + t / ROW_STEP][t % ROW_STEP] = decoded_integer(S, lane, header, q0, q1, mask)
      PUT_WEIGHT(0u); PUT_WEIGHT(1u); PUT_WEIGHT(2u); PUT_WEIGHT(3u);
      PUT_WEIGHT(4u); PUT_WEIGHT(5u); PUT_WEIGHT(6u); PUT_WEIGHT(7u);
#undef PUT_WEIGHT
    } else {
      for (uint k = t / ROW_STEP; k < 32u; k += 4u) wt[k][t % ROW_STEP] = 0;
    }
#else
    for (uint k = t / ROW_STEP; k < 32u; k += 4u)
      wt[k][t % ROW_STEP] = row < p.M ? integer_weight(b, row, (k / 4u) * 32u + 4u * lane + k % 4u) : 0;
#endif
#if MTILE == 32
    }
#endif
#if NTILE == 64
    for (uint index = t; index < 64u * 32u; index += 256u) {
#else
    for (uint index = t; index < uint(NTILE) * 32u; index += 256u) {
#endif
      const uint k = index % 32u, col = col0 + index / 32u;
      xt[index / 32u][k] = col < p.N ? x[col * p.K + b * 256u + k / 4u * 32u + 4u * lane + k % 4u] : 0;
    }
    if (t < ROW_STEP) {
#if NTILE == 64 && MTILE == 64
      const uint row = row0 + t, col = col0 + t;
#else
      const uint row = row0 + t;
#endif
#ifdef TYPE_Q2K
      const vec2 dm = row < p.M ? unpackHalf2x16(w[p.side / 4u + b * p.Mp + row]) : vec2(0);
      wd[t] = dm.x; wm[t] = dm.y;
      min0[t] = row < p.M ? float(byte_at(b, 2u * lane, row) >> 4u) : 0;
      min1[t] = row < p.M ? float(byte_at(b, 2u * lane + 1u, row) >> 4u) : 0;
#else
      wd[t] = row < p.M ? unpackHalf2x16(w[p.side / 4u + (b * 4u + 3u) * p.Mp + row]).x : 0;
#endif
#if NTILE != 64 || MTILE != 64
    }
    if (t < uint(NTILE)) {
      const uint col = col0 + t;
#endif
      xd[t] = col < p.N ? meta[(col * blocks + b) * 17u] : 0;
      sum0[t] = col < p.N ? meta[(col * blocks + b) * 17u + 1u + 2u * lane] : 0;
      sum1[t] = col < p.N ? meta[(col * blocks + b) * 17u + 2u + 2u * lane] : 0;
    }
    barrier();
#if MTILE == 64
    Panel l0 = Panel(0), l1 = Panel(0), l2 = Panel(0), l3 = Panel(0);
#else
    Panel l0 = Panel(0), l1 = Panel(0);
#endif
    for (uint k = 0; k < 32u; ++k) {
      const Panel xv = X_PANEL(k);
      l0 = fma(Panel(wt[k][ri]), xv, l0);
      l1 = fma(Panel(wt[k][ri + 16u]), xv, l1);
#if MTILE == 64
      l2 = fma(Panel(wt[k][ri + 32u]), xv, l2);
      l3 = fma(Panel(wt[k][ri + 48u]), xv, l3);
#endif
    }
    const Panel yd = META_PANEL(xd);
#ifdef TYPE_Q2K
    const Panel s0 = META_PANEL(sum0);
    const Panel s1 = META_PANEL(sum1);
    precise Panel dm0 = -wm[ri] * yd, dm1 = -wm[ri + 16u] * yd;
#if MTILE == 64
    precise Panel dm2 = -wm[ri + 32u] * yd, dm3 = -wm[ri + 48u] * yd;
#endif
#ifdef TRACE_BLOCK_SCALE
    const uint trace_at = (lane * blocks + b) * 8u;
    const bool trace_this = t == 0u && gl_WorkGroupID.x == 0u && gl_WorkGroupID.y == 0u;
    if (trace_this) {
      block_trace[trace_at] = dm0.x;
      block_trace[trace_at + 1u] = min0[ri] * s0.x + min1[ri] * s1.x;
      block_trace[trace_at + 2u] = acc0.x;
    }
#endif
    acc0 = SCALE_FMA(dm0, min0[ri] * s0 + min1[ri] * s1, acc0);
    acc1 = SCALE_FMA(dm1, min0[ri + 16u] * s0 + min1[ri + 16u] * s1, acc1);
#if MTILE == 64
    acc2 = SCALE_FMA(dm2, min0[ri + 32u] * s0 + min1[ri + 32u] * s1, acc2);
    acc3 = SCALE_FMA(dm3, min0[ri + 48u] * s0 + min1[ri + 48u] * s1, acc3);
#endif
#ifdef TRACE_BLOCK_SCALE
    if (trace_this) block_trace[trace_at + 3u] = acc0.x;
#endif
#endif
    precise Panel d0 = wd[ri] * yd, d1 = wd[ri + 16u] * yd;
#if MTILE == 64
    precise Panel d2 = wd[ri + 32u] * yd, d3 = wd[ri + 48u] * yd;
#endif
#ifdef TRACE_BLOCK_SCALE
    if (trace_this) {
      block_trace[trace_at + 4u] = d0.x;
      block_trace[trace_at + 5u] = l0.x;
      block_trace[trace_at + 7u] = wd[ri];
    }
#endif
    acc0 = SCALE_FMA(d0, l0, acc0); acc1 = SCALE_FMA(d1, l1, acc1);
#ifdef TRACE_BLOCK_SCALE
    if (trace_this) block_trace[trace_at + 6u] = acc0.x;
#endif
#if MTILE == 64
    acc2 = SCALE_FMA(d2, l2, acc2); acc3 = SCALE_FMA(d3, l3, acc3);
#endif
    barrier();
  }
#if NTILE == 64
  for (uint r = 0; r < ROW_GROUPS; ++r) for (uint c = 0; c < 4u; ++c) {
#else
  for (uint r = 0; r < ROW_GROUPS; ++r) for (uint c = 0; c < uint(NTILE) / 16u; ++c) {
#endif
    const uint row = row0 + ri + 16u * r, col = col0 + ci + 16u * c;
    if (row < p.M && col < p.N) {
#if MTILE == 64
      const Panel a = r == 0u ? acc0 : r == 1u ? acc1 : r == 2u ? acc2 : acc3;
#else
      const Panel a = r == 0u ? acc0 : acc1;
#endif
#if NTILE == 16
      part[(lane * p.N + col) * p.M + row] = a;
#else
      part[(lane * p.N + col) * p.M + row] = a[c];
#endif
    }
  }
}
