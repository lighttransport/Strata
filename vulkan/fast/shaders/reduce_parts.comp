#version 450
// Sums K-split partial products in a fixed order: y[yofs+n*ys+row] (+)= sum_z part[(z*N+n)*M+row].
layout(local_size_x = 256) in;
layout(binding = 0, std430) readonly restrict buffer Part { float part[]; };
layout(binding = 1, std430) restrict buffer Y { float y[]; };
layout(push_constant) uniform P { uint M, N, ys, yofs, parts, accumulate; } p;
void main() {
  const uint i = gl_GlobalInvocationID.x;
  if (i >= p.M * p.N) return;
  const uint n = i / p.M, row = i % p.M;
  float v = 0;
  for (uint z = 0; z < p.parts; z++) v += part[z * p.M * p.N + i];
  const uint o = p.yofs + n * p.ys + row;
  y[o] = p.accumulate != 0 ? y[o] + v : v;
}
