# Opt-in settings for the measured Xeon Gold / Tesla V100 profile.
# For one GPU, unset PRIMARY_GROUPS, PREFETCH_GROUPS and MLA_SPLIT (STRATA_GLM_ prefix).
export STRATA_GLM_ACTIVE_POOLS=1
export STRATA_GLM_ASYNC_DECODE_FILL=1
export STRATA_GLM_ASYNC_MOE=1
export STRATA_GLM_ASYNC_PEER_RETURN=2
export STRATA_GLM_DEFER_PREFILL_REPAIR=1
export STRATA_GLM_DEQUANT_COALESCED=1
export STRATA_GLM_DEQUANT_ONCE=1
export STRATA_GLM_DEVICE_EXPERTS=1
export STRATA_GLM_DEVICE_REDUCTION=1
export STRATA_GLM_DIRECT_WEIGHT_UPLOAD=1
export STRATA_GLM_EARLY_ROUTE_SYNC=1
export STRATA_GLM_F16_BUCKETS=1
export STRATA_GLM_FUSED_CLAMP=1
export STRATA_GLM_HALF_X=1
export STRATA_GLM_IQ_COALESCED=8
export STRATA_GLM_KDA_PREPARE=1
export STRATA_GLM_KDA_ROW_PARTS=8
export STRATA_GLM_LAYER_GRAPHS=1
export STRATA_GLM_MLA_F16=1
export STRATA_GLM_MLA_SPLIT=45
export STRATA_GLM_MLA_VECTOR_GATHER=1
export STRATA_GLM_PARTIAL_RETURN=1
export STRATA_GLM_PREFETCH_GROUPS=7
export STRATA_GLM_PRIMARY_GROUPS=7
export STRATA_GLM_QUANT_ONCE=1
export STRATA_GLM_RESTORE_PREFILL_CACHE=1
export STRATA_GLM_STABLE_ROUTES=1
export STRATA_NATIVE_NUMA_LOCAL=0
export STRATA_OLD_IQ_MMVQ=1
export STRATA_GLM_ADMIT_MIN=3
