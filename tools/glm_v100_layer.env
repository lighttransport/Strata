# Opt-in environment used by the Xeon Gold / V100 layer-layout experiments.
# Start with inherited STRATA_* settings cleared. tools/glm_v100.env selects
# the separate legacy GPU-helper path and cannot be combined with this recipe.
# Native Q2 and Q23 profiles leave STRATA_GLM_CANON unset. Canonical K-expert
# experiments set it to 1 separately; see the report's measured quality gates.
export STRATA_GLM_STEP_PIPELINE=1
export STRATA_GLM_ACTIVE_POOLS=1
export STRATA_GLM_DEVICE_EXPERTS=1
export STRATA_GLM_DEVICE_REDUCTION=1
export STRATA_GLM_LAYER_GRAPHS=1
export STRATA_GLM_KDA_PREPARE=1
export STRATA_GLM_DEQUANT_COALESCED=1
export STRATA_GLM_DEQUANT_ONCE=1
export STRATA_OLD_IQ_MMVQ=1
export STRATA_NATIVE_NUMA_LOCAL=0
export STRATA_GLM_KDA_ROW_PARTS=8
export STRATA_GLM_IQ_COALESCED=8
export STRATA_GLM_PACK_FUSE_QUANT=0
export STRATA_GLM_Q2_NUMA_WEIGHTS=0
export STRATA_GLM_STABLE_ROUTES=1
