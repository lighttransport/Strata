# reversed layout (decoder on the B550's 5060 Ti, CPU-only worker on TR16): the best exact (token-identical) settings so far, 2026-10-30.
# c_osd 1,000-token prompt, 128 generated: 15.8-16.3 tok/s (the same layout before the session's changes: 9.7-10.1); c_llama 15.9 against 11.7 for plain decoding.
# Worker (rev_node.sh): W_THREADS=14, W_ARGS="--numa-place --helper-cpus=14,15,30,31",
#   W_ENV="STRATA_IQ1S_GRID8=1 STRATA_IQ1S_PAIR=1 STRATA_DS41_LANE_GROUP_EXACT=1 STRATA_DS41_LANE_SKIP_UNUSED=1 STRATA_DS41_LANE_SLEEP=0 STRATA_DS41_LANE_NUMA=1"
# Decoder (rev_node.sh): ADAPT=3000 (also starts the worker's fetch service), D_THREADS=14, plus the environment below.
STRATA_DS41_CANON_MIB=5600
STRATA_DS41_DESKTOP_MIB=512
STRATA_DS41_HELPER_CPUS=14,15,30,31
STRATA_DS41_ADAPT_GAP_MS=30
STRATA_DS41_ADAPT_OWNED_WEIGHT=2
STRATA_DS41_DSPARK_N=3
STRATA_DS41_DSPARK_PMIN=0.4
STRATA_DS41_FUSE=1
