# reversed layout, batched sessions (STRATA_DS41_SESSIONS=S, plain decode), 2026-10-30: best exact-gate settings so far (cfg16.sh applies them).
# Feed:   NO_DSPARK=1 KEEP_MIB=34000 ./rev_node.sh feed NAME      (the B550 keeps 34 GB of the hottest experts, no drafter in tmpfs)
# Run:    KEEP_MIB=34000 CANON=6000 CTX=2000 ./cfg16.sh NAME 48 STRATA_DS41_MERGE_DIRECT=1 STRATA_DS41_MERGE_VECTOR=1 STRATA_IQ1S_VIDX=1   with W_EXTRA="STRATA_IQ1S_VIDX=1"
# Aggregate tok/s (plain decode, 120-token c_osd slices): S=32 50.9, S=48 54-57, S=64 56.
STRATA_DS41_SESSIONS=48
STRATA_DS41_CANON_TOKENS=48
STRATA_DS41_CANON_MIB=6000
STRATA_DS41_DENSE_MMQ=1
STRATA_MMQ_KQ=1
STRATA_DS41_MERGE_DIRECT=1
STRATA_DS41_MERGE_VECTOR=1
STRATA_IQ1S_GRID8=1
STRATA_IQ1S_PAIR=1
STRATA_IQ1S_VIDX=1
STRATA_DS41_ATTN_MULTI=0
STRATA_DS41_VERIFY_FAST_TRUNK=0
STRATA_DS41_CANON_ADAPT=3000
STRATA_DS41_ADAPT_GAP_MS=30
STRATA_DS41_ADAPT_OWNED_WEIGHT=2
STRATA_DS41_HELPER_CPUS=14,15,30,31
