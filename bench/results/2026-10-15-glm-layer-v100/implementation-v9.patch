+#include "strata/host/glm_layer.h"
+#include <stdio.h>
+#include <string.h>
+#define CHECK(x) do { if (!(x)) { fprintf(stderr,"line %d: %s\n",__LINE__,#x); return 1; } } while (0)
+int main(void) {
+    int b[17], before[17], n, l, s;
+    for (n = 1; n <= 16; ++n) {
+        CHECK(!strata_glm_layer_bounds("auto",45,n,b));
+        CHECK(b[0]==0 && b[n]==45);
+        for (s=0;s<n;++s) CHECK(b[s]<b[s+1]);
+        for (l=0;l<=45;++l) {
+            int owners=0; char name[64];
+            snprintf(name,sizeof(name),"blk.%d.attn_norm.weight",l);
+            for (s=0;s<n;++s) owners+=strata_glm_layer_tensor_owned(name,b[s],b[s+1],45,1);
+            CHECK(owners==1);
+        }
+    }
+    CHECK(!strata_glm_layer_bounds("24",45,2,b) && b[1]==24);
+    CHECK(!strata_glm_layer_bounds("3,4,44",45,4,b));
+    memset(b,7,sizeof(b)); memcpy(before,b,sizeof(b));
+    const char *bad[]={"","0","45","-1","+24"," 24","24 ","24,","24,25","999999999999999999999"};
+    for (s=0;s<(int)(sizeof(bad)/sizeof(*bad));++s) {
+        CHECK(strata_glm_layer_bounds(bad[s],45,2,b)==-1);
+        CHECK(!memcmp(b,before,sizeof(b)));
+    }
+    CHECK(strata_glm_layer_bounds("4,3",45,3,b)==-1);
+    CHECK(strata_glm_layer_bounds("auto",2,3,b)==-1);
+    CHECK(strata_glm_layer_tensor_owned("token_embd.weight",0,24,45,1));
+    CHECK(!strata_glm_layer_tensor_owned("output.weight",0,24,45,1));
+    CHECK(strata_glm_layer_tensor_owned("output.weight",24,45,45,1));
+    CHECK(!strata_glm_layer_tensor_owned("blk.45.attn_norm.weight",24,45,45,0));
+    CHECK(!strata_glm_layer_tensor_owned("blk.x.bad",24,45,45,1));
+    return 0;
+}
diff --git a/tests/host/layer_pipeline_test.cpp b/tests/host/layer_pipeline_test.cpp
new file mode 100644
index 00000000..ce141c4e
--- /dev/null
+++ b/tests/host/layer_pipeline_test.cpp
@@ -0,0 +1,120 @@
+#include "strata/spec/layer_pipeline.hpp"
+#include <array>
+#include <atomic>
+#include <future>
+#include <iostream>
+#include <stdexcept>
+#include <vector>
+
+// A recurrent head and a tail with a four-token open pool and an 8192-entry
+// ring. Rolled-back slots deliberately retain stale values, as GPU memory does.
+struct Backend {
+    struct State { int position; uint64_t recurrent; std::array<uint64_t,4> open; };
+    struct Hop { uint64_t generation=0, value=0; bool live=false; };
+    State head{}, saved{}, tail{};
+    std::array<Hop,2> hops;
+    std::array<uint64_t,8192> ring{};
+    bool miss;
+    int draft_calls=0, head_calls=0, fail_at=-1, window=0, policy=0;
+    int head_routes=0,saved_routes=0,tail_routes=0;
+    explicit Backend(int pos,bool misses,int w=0):miss(misses),window(w) {head.position=tail.position=pos;}
+    static void step(State &s,int token) {
+        s.recurrent=s.recurrent*6364136223846793005ULL+unsigned(token)+s.position;
+        s.open[s.position%4]=s.recurrent;
+        ++s.position;
+    }
+    static int next(int token) {return (token*13+7)%113;}
+    std::future<void> start_head(int token,int slot,uint64_t gen) {
+        if(hops[slot].live)throw std::logic_error("overwrite live slot");
+        hops[slot].live=true;hops[slot].generation=gen;
+        return std::async(std::launch::async,[=,this]{
+            ++head_calls;
+            ++head_routes;step(head,token+policy*131);ring[(head.position-1)%8192]=head.recurrent;
+            hops[slot].value=head.recurrent;
+            if(head_calls==fail_at)throw std::runtime_error("forced head failure");
+        });
+    }
+    void save_head(){saved=head;saved_routes=head_routes;}
+    void restore_head(){head=saved;head_routes=saved_routes;}
+    bool window_due(uint64_t consumed)const{return window && consumed%(unsigned)window==0;}
+    void rebalance(){
+        if(head_routes!=tail_routes||head.position!=tail.position||head.recurrent!=tail.recurrent)
+            throw std::logic_error("policy updated outside confirmed frontier");
+        head_routes=tail_routes=0;++policy;
+    }
+    void release(int slot,uint64_t gen){
+        if(!hops[slot].live||hops[slot].generation!=gen)throw std::logic_error("stale hop");
+        hops[slot].live=false;
+    }
+    int draft(int token){++draft_calls;return next(token)+(miss&&draft_calls%2?1:0);}
+    std::future<void> start_draft(int token,int &out){return std::async(std::launch::async,[&,token]{out=draft(token);});}
+    int confirm(int token,int slot,uint64_t gen){
+        if(!hops[slot].live||hops[slot].generation!=gen)throw std::logic_error("unpublished hop");
+        ++tail_routes;step(tail,token+policy*131);
+        if(tail.recurrent!=hops[slot].value)throw std::logic_error("unconfirmed input reached tail");
+        release(slot,gen);return next(token);
+    }
+};
+struct PrefillBackend {
+    struct Hop{uint64_t generation=0,value=0;bool live=false;};
+    std::vector<std::array<Hop,2>> hops;
+    std::vector<size_t> positions;
+    std::vector<uint64_t> output;
+    std::atomic<int> active{0};
+    bool fail=false;
+    explicit PrefillBackend(size_t stages,size_t panels):hops(stages-1),positions(stages),output(panels){}
+    static uint64_t expected(size_t stages,size_t panel){return (stages*(stages+1)/2)*100+stages*panel;}
+    std::future<void> start(size_t stage,size_t panel){
+        const uint64_t gen=panel+1;const size_t slot=gen&1;
+        uint64_t input=0;
+        if(stage){auto &h=hops[stage-1][slot];if(!h.live||h.generation!=gen)throw std::logic_error("stale prefill source");input=h.value;}
+        if(stage+1<positions.size()){auto &h=hops[stage][slot];if(h.live)throw std::logic_error("prefill slot overwritten");h.live=true;h.generation=gen;}
+        return std::async(std::launch::async,[=,this]{
+            ++active;
+            if(positions[stage]++!=panel){--active;throw std::logic_error("prefill reordered a layer");}
+            uint64_t result=input+(stage+1)*100+panel;
+            if(stage+1<positions.size())hops[stage][slot].value=result;else output[panel]=result;
+            --active;
+            if(fail&&stage==1&&panel==1)throw std::runtime_error("forced prefill failure");
+        });
+    }
+    void complete(size_t stage,size_t panel){if(stage)hops[stage-1][(panel+1)&1].live=false;}
+};
+int main(){
+    try {
+        for(int pos:{0,2,3,4,254,255,256,8190,8191,8192})for(bool misses:{false,true})for(int count:{1,2,7,17})for(int window:{0,2,7}) {
+            Backend b(pos,misses,window);int token=11, emitted=0;
+            auto stats=strata::spec::run_layer_pipeline(b,token,[&](int actual){
+                token=Backend::next(token);
+                if(actual!=token)throw std::runtime_error("wrong output");
+                return ++emitted==count;
+            });
+            if(b.head.position!=b.tail.position||b.head.recurrent!=b.tail.recurrent||b.head.open!=b.tail.open)
+                throw std::runtime_error("frontiers differ");
+            if(b.head_routes!=b.tail_routes || (window && b.policy!=(count-1)/window))throw std::runtime_error("uncommitted route statistics");
+            if(stats.proposed!=(unsigned)count||(!misses&&stats.accepted!=stats.proposed))throw std::runtime_error("wrong accounting");
+            for(const auto &h:b.hops)if(h.live)throw std::runtime_error("leaked hop");
+        }
+        for(int pos:{3,255,8191}) {
+            Backend b(pos,true);int emitted=0;
+            try {strata::spec::run_layer_pipeline(b,11,[&](int){if(++emitted==4)throw std::runtime_error("cancelled");return false;});}
+            catch(const std::runtime_error &e){if(std::string(e.what())!="cancelled")throw;}
+            if(b.head.position!=b.tail.position||b.head.recurrent!=b.tail.recurrent||b.head.open!=b.tail.open)throw std::runtime_error("cancel rollback differs");
+        }
+        for(size_t stages:{2,3,4,16})for(size_t panels:{1,2,3,17}) {
+            PrefillBackend b(stages,panels);
+            strata::spec::run_layer_prefill(b,panels,stages);
+            for(size_t p=0;p<panels;++p)if(b.output[p]!=PrefillBackend::expected(stages,p))throw std::runtime_error("prefill result differs");
+            for(const auto &pair:b.hops)for(const auto &h:pair)if(h.live)throw std::runtime_error("prefill slot leaked");
+        }
+        PrefillBackend failed(4,8);failed.fail=true;
+        try{strata::spec::run_layer_prefill(failed,8,4);return 4;}
+        catch(const std::runtime_error &e){if(std::string(e.what())!="forced prefill failure")throw;}
+        if(failed.active.load())throw std::runtime_error("prefill failure left an active job");
+        Backend b(8191,false);b.fail_at=2;
+        try {strata::spec::run_layer_pipeline(b,11,[](int){return false;});return 2;}
+        catch(const std::runtime_error &e){if(std::string(e.what())!="forced head failure")throw;}
+        if(b.head.position!=b.saved.position||b.head.recurrent!=b.saved.recurrent)return 3;
+        std::cout<<"layer pipeline: 240 decode traces, 16 prefill traces, cancellation and failures passed\n";
+    }catch(const std::exception &e){std::cerr<<e.what()<<'\n';return 1;}
+}
diff --git a/tools/glm_layer_tune.py b/tools/glm_layer_tune.py
new file mode 100644
index 00000000..830a66d1
--- /dev/null
+++ b/tools/glm_layer_tune.py
@@ -0,0 +1,87 @@
+"""Select a measured GLM layer cut from comparable completed benchmark records."""
+import argparse
+import hashlib
+import json
+import math
+import pathlib
+import statistics
+
+MATCH = ("context", "threads", "gpu_devices", "gpu_budget_mib", "decode_cache_mib",
+         "decode_cache_window", "decode_cache_adapt", "decode_graphs", "prefill_batch",
+         "speculative", "draft_depth", "layer_pipeline", "layer_memory", "prompt_tokens", "generated_tokens",
+         "repetitions", "validation_tokens", "validation_repetitions", "full_warmups", "cpu_affinity")
+CRITICAL_ENV = ("STRATA_GLM_CANON", "STRATA_GLM_Q8_DECODE", "STRATA_GLM_STEP_PIPELINE",
+                "STRATA_GLM_DEVICE_EXPERTS", "STRATA_GLM_DEVICE_REDUCTION", "STRATA_GLM_LAYER_GRAPHS",
+                "STRATA_GLM_KDA_PREPARE", "STRATA_GLM_KDA_ROW_PARTS", "STRATA_OLD_IQ_MMVQ")
+
+
+def select_plan(records, model):
+    if len(records) < 2:
+        raise ValueError("provide at least two measured cuts")
+    first = records[0]
+    cfg = first["configuration"]
+    expected = {k: cfg.get(k, "interleave" if k == "layer_memory" else None) for k in MATCH}
+    expected["layer_memory"] = expected["layer_memory"] or "interleave"
+    expected["pin_cpu"] = cfg.get("cpu_affinity", "auto") != "none"
+    environment = {k: first.get("environment", {}).get(k) for k in sorted(set(first.get("environment", {})) | set(CRITICAL_ENV))}
+    candidates = []
+    for record in records:
+        current = record["configuration"]
+        settings = {k: current.get(k, "interleave" if k == "layer_memory" else None) for k in MATCH}
+        settings["layer_memory"] = settings["layer_memory"] or "interleave"
+        settings["pin_cpu"] = current.get("cpu_affinity", "auto") != "none"
+        env = {k: record.get("environment", {}).get(k) for k in sorted(set(record.get("environment", {})) | set(CRITICAL_ENV))}
+        if (settings != expected or env != environment or record["decoder_sha256"] != first["decoder_sha256"] or
+                record["decoder_fnv64"] != first["decoder_fnv64"] or record["prompt_sha256"] != first["prompt_sha256"] or current["model"] != cfg["model"] or
+                record.get("hardware") != first.get("hardware")):
+            raise ValueError("cuts must share model, binary, hardware, prompt, environment and settings")
+        if (current.get("gpu_layout") != "layer" or not record.get("complete") or record.get("instrumented") or
+                not record.get("repetitions_identical") or len(record.get("trials", [])) < 2):
+            raise ValueError("only complete, repeated, stable, uninstrumented layer runs qualify for placement selection")
+        split = current.get("layer_split")
+        devices = [int(x) for x in str(current["gpu_devices"]).split(",")]
+        try:
+            bounds = [0] + [int(x) for x in str(split).split(",")] + [45]
+        except (ValueError, TypeError) as exc:
+            raise ValueError("measure explicit GLM-5.3 layer cuts") from exc
+        if len(bounds) != len(devices) + 1 or any(a >= b for a, b in zip(bounds, bounds[1:])):
+            raise ValueError("invalid or empty stage in measured cut")
+        if any(len(t["token_ids"]) < 2 or not math.isfinite(t["decode_ms"]) or t["decode_ms"] <= 0
+               or t["token_ids"] != record["trials"][0]["token_ids"] for t in record["trials"]):
+            raise ValueError("invalid or unstable measured decode trials")
+        timings = [(len(t["token_ids"]) - 1) * 1000.0 / t["decode_ms"] for t in record["trials"]]
+        candidates.append({"layer_split": str(split), "median_decode_tok_s": statistics.median(timings),
+                           "decode_tok_s": timings})
+    if len({r["layer_split"] for r in candidates}) < 2:
+        raise ValueError("provide at least two distinct measured cuts")
+    best = max(candidates, key=lambda r: (r["median_decode_tok_s"], r["layer_split"]))
+    model = pathlib.Path(model)
+    if model.resolve() != pathlib.Path(cfg["model"]).resolve():
+        raise ValueError("provided model differs from the measured model")
+    return dict(schema="strata.glm.layer-plan.v1", model_filename=model.name, model_bytes=model.stat().st_size,
+                configuration=expected, environment=environment, hardware=first.get("hardware", {}),
+                decoder_sha256=first["decoder_sha256"], decoder_fnv64=first["decoder_fnv64"], prompt_sha256=first["prompt_sha256"],
+                layer_split=best["layer_split"], candidates=candidates,
+                timing_scope="measured single-stream decode; placement screening, not a coding-quality qualification")
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__)
+    ap.add_argument("records", type=pathlib.Path, nargs="+")
+    ap.add_argument("--model", type=pathlib.Path, required=True)
+    ap.add_argument("--output", type=pathlib.Path, required=True)
+    args = ap.parse_args()
+    if args.output.exists():
+        ap.error("output exists; preserve the previous measured plan")
+    try:
+        records = [json.loads(p.read_text()) for p in args.records]
+        plan = select_plan(records, args.model)
+    except (ValueError, KeyError, OSError) as exc:
+        ap.error(str(exc))
+    plan["records"] = [{"name": p.name, "sha256": hashlib.sha256(p.read_bytes()).hexdigest()} for p in args.records]
+    args.output.write_text(json.dumps(plan, indent=2) + "\n")
+    print(f"selected layer_split={plan['layer_split']}; plan={args.output}")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tools/glm_v100_layer.env b/tools/glm_v100_layer.env
new file mode 100644
index 00000000..accf2b60
--- /dev/null
+++ b/tools/glm_v100_layer.env
@@ -0,0 +1,10 @@
+# Opt-in GLM layer layout. Start from a shell with inherited STRATA_* settings
