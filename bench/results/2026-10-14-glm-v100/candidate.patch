+    greedy_partials<<<blocks, 256, 0, (cudaStream_t)s>>>(logits, vocabulary, (GreedyPartial *)scratch);
+    check();
+    greedy_finish<<<1, 256, 0, (cudaStream_t)s>>>((const GreedyPartial *)scratch, blocks, result);
+    check();
+}
